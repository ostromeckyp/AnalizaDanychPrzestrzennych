{
 "openapi": "3.1.0",
 "info": {
  "title": "Mielizna API",
  "version": "0.1.0"
 },
 "paths": {
  "/api/meta": {
   "get": {
    "summary": "Meta",
    "operationId": "meta_api_meta_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/MetaResponse"
        }
       }
      }
     }
    }
   }
  },
  "/api/zones": {
   "get": {
    "summary": "Zones",
    "operationId": "zones_api_zones_get",
    "parameters": [
     {
      "name": "h",
      "in": "query",
      "required": true,
      "schema": {
       "type": "number",
       "title": "H"
      }
     },
     {
      "name": "draft",
      "in": "query",
      "required": false,
      "schema": {
       "type": "number",
       "maximum": 3.0,
       "minimum": 0.1,
       "default": 1.2,
       "title": "Draft"
      }
     },
     {
      "name": "margin",
      "in": "query",
      "required": false,
      "schema": {
       "type": "number",
       "maximum": 1.0,
       "minimum": 0.0,
       "default": 0.3,
       "title": "Margin"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ZonesResponse"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/point": {
   "get": {
    "summary": "Point",
    "operationId": "point_api_point_get",
    "parameters": [
     {
      "name": "lon",
      "in": "query",
      "required": true,
      "schema": {
       "type": "number",
       "maximum": 180,
       "minimum": -180,
       "title": "Lon"
      }
     },
     {
      "name": "lat",
      "in": "query",
      "required": true,
      "schema": {
       "type": "number",
       "maximum": 90,
       "minimum": -90,
       "title": "Lat"
      }
     },
     {
      "name": "h",
      "in": "query",
      "required": true,
      "schema": {
       "type": "number",
       "title": "H"
      }
     },
     {
      "name": "draft",
      "in": "query",
      "required": false,
      "schema": {
       "type": "number",
       "maximum": 3.0,
       "minimum": 0.1,
       "default": 1.2,
       "title": "Draft"
      }
     },
     {
      "name": "margin",
      "in": "query",
      "required": false,
      "schema": {
       "type": "number",
       "maximum": 1.0,
       "minimum": 0.0,
       "default": 0.3,
       "title": "Margin"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/PointResponse"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/scenes": {
   "get": {
    "summary": "Scenes",
    "operationId": "scenes_api_scenes_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "items": {
          "$ref": "#/components/schemas/SceneOut"
         },
         "type": "array",
         "title": "Response Scenes Api Scenes Get"
        }
       }
      }
     }
    }
   }
  },
  "/api/shorelines": {
   "get": {
    "summary": "Shorelines",
    "operationId": "shorelines_api_shorelines_get",
    "parameters": [
     {
      "name": "date",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
       "title": "Date"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ShorelineFeature"
        }
       }
      }
     },
     "404": {
      "description": "brak opublikowanej linii brzegowej dla tej daty"
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/marinas": {
   "get": {
    "summary": "Marinas",
    "operationId": "marinas_api_marinas_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/MarinasResponse"
        }
       }
      }
     }
    }
   }
  },
  "/api/gravel": {
   "get": {
    "summary": "Gravel",
    "description": "Obrys żwirowni (dno zmienne) jako GeoJSON w EPSG:4326 z atrybucją mapy KŻ.",
    "operationId": "gravel_api_gravel_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/GravelResponse"
        }
       }
      }
     },
     "404": {
      "description": "brak pliku z obrysem żwirowni"
     }
    }
   }
  },
  "/api/capacity-to-level": {
   "get": {
    "summary": "Capacity To Level Ep",
    "description": "Pojemność v [mln m³] (0 < v ≤ 200, inaczej 422) → rzędna; poza tabelą KŻ h=None.",
    "operationId": "capacity_to_level_ep_api_capacity_to_level_get",
    "parameters": [
     {
      "name": "v",
      "in": "query",
      "required": true,
      "schema": {
       "type": "number",
       "maximum": 200.0,
       "exclusiveMinimum": 0,
       "title": "V"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/CapacityToLevel"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/level-to-capacity": {
   "get": {
    "summary": "Level To Capacity Ep",
    "description": "Rzędna h [m n.p.m.] (180–210, inaczej 422) → pojemność [mln m³]; poza tabelą KŻ v=None.",
    "operationId": "level_to_capacity_ep_api_level_to_capacity_get",
    "parameters": [
     {
      "name": "h",
      "in": "query",
      "required": true,
      "schema": {
       "type": "number",
       "maximum": 210.0,
       "minimum": 180.0,
       "title": "H"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/LevelToCapacity"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/current-level": {
   "get": {
    "summary": "Current Level",
    "description": "Bieżący poziom (najnowsza scena S2 albo pipeline); odpowiedź natychmiastowa, zawsze 200.",
    "operationId": "current_level_api_current_level_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/CurrentLevelResponse"
        }
       }
      }
     }
    }
   }
  },
  "/api/bulletin/latest": {
   "get": {
    "summary": "Bulletin Latest",
    "description": "Najnowszy komunikat Wód Polskich: pojemność i rzędna z tabeli KŻ; przy braku sieci ostatni znany (`stale`).",
    "operationId": "bulletin_latest_api_bulletin_latest_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/BulletinLatest"
        }
       }
      }
     },
     "404": {
      "description": "brak komunikatu (sieć niedostępna i brak danych pipeline'u)"
     }
    }
   }
  },
  "/api/layers/bottom.png": {
   "get": {
    "summary": "Bottom Png",
    "description": "Dno w 5 klasach (RGBA, EPSG:3857); narożniki i progi w `/api/meta`.",
    "operationId": "bottom_png_api_layers_bottom_png_get",
    "parameters": [
     {
      "name": "theme",
      "in": "query",
      "required": true,
      "schema": {
       "enum": [
        "light",
        "dark"
       ],
       "type": "string",
       "title": "Theme"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "image/png": {}
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/layers/uncertainty.png": {
   "get": {
    "summary": "Uncertainty Png",
    "description": "Kropki niepewności (RGBA, 2× rozdzielczość, EPSG:3857).",
    "operationId": "uncertainty_png_api_layers_uncertainty_png_get",
    "parameters": [
     {
      "name": "theme",
      "in": "query",
      "required": true,
      "schema": {
       "enum": [
        "light",
        "dark"
       ],
       "type": "string",
       "title": "Theme"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "image/png": {}
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  }
 },
